*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#07090b;font-family:Inter,Arial,sans-serif;color:#fff;touch-action:none}canvas{display:block}.brand{position:fixed;top:22px;left:24px;z-index:5;font-size:19px;font-weight:900;letter-spacing:4px;text-shadow:0 2px 12px #000}.brand span{opacity:.55}.stats{position:fixed;top:18px;right:20px;z-index:5;display:flex;gap:14px}.stats div{min-width:72px;padding:8px 10px;border:1px solid #ffffff20;border-radius:12px;background:#050607aa;backdrop-filter:blur(10px);text-align:center;box-shadow:0 8px 30px #0008}.stats b{display:block;font-size:25px}.stats small{font-size:8px;letter-spacing:2px;opacity:.55}.hint{position:fixed;left:50%;bottom:104px;transform:translateX(-50%);z-index:5;padding:8px 14px;border-radius:20px;background:#05060799;font-size:11px;letter-spacing:.6px;opacity:.7}.hint.hide{opacity:0;transition:opacity .5s}.controls{position:fixed;bottom:24px;left:0;right:0;display:flex;justify-content:center;gap:18px;z-index:8}button{width:150px;height:62px;border-radius:18px;border:1px solid #ffffff25;background:#090b0dcc;color:#fff;font-weight:800;letter-spacing:2px;backdrop-filter:blur(14px);box-shadow:0 10px 30px #0009}button:active{transform:scale(.97);background:#1a1d20ee}#loading{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:#07090b;font-size:12px;letter-spacing:4px;transition:opacity .7s}.gone{opacity:0;pointer-events:none}@media(min-width:800px){.controls{display:none}.hint{bottom:30px}}